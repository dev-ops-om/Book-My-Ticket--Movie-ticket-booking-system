PORT=8080
NODE_ENV=development

# 1. MongoDB Atlas (Users & Auth)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/book_my_ticket?authSource=admin&retryWrites=true&w=majority

# 2. Supabase PostgreSQL IPv4 Pooler (Use Pooler for Render deployment)
DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# 3. JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_12345
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_67890
JWT_REFRESH_EXPIRES_IN=7d

# 4. Mailtrap SMTP (Verification & Reset Emails)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
SMTP_FROM_NAME="BookMyTicket"
SMTP_FROM_EMAIL=noreply@bookmyticket.com

CLIENT_URL=http://localhost:8080
